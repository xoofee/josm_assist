/* ===============================
   Parking space name validation
   =============================== 
   
in vscode:

<tag k='name' v='.*[^A-NP-Za-np-z0-9-].*' />



   */


*[amenity=parking_space][verified!="true"][!name],
*[amenity=parking_space][verified!="true"][name=""],
*[amenity=parking_space][verified!="true"][name!~/^[A-HJ-NP-Ya-hj-np-y0-9-]+$/] {
    color: #00E5FF;          /* cyan, NOT selection red */
    width: 4;
    fill-color: #00E5FF;
    fill-opacity: 0.35;
    casing-color: white;    /* sharp edge on black bg */
    casing-width: 2;
    z-index: 10;
}

*[amenity=parking_space][verified="true"] {
    color: #00FF0DFF;          /* green for verified (with alpha) */
    width: 2;
    casing-color: white;    /* sharp edge on black bg */
    casing-width: 1;
    z-index: 20;
}


/* Ways without level tag (e.g. parking_space / indoor) */
way[!level] {
    color: #FF9800;         /* orange: missing level */
    width: 3;
    fill-color: #FF9800;
    fill-opacity: 0.25;
    casing-color: white;
    casing-width: 1;
    z-index: 5;
}

*[barrier=wall] {
    color:rgb(218, 226, 219);          /* green for verified (with alpha) */
    width: 2;
    casing-color: white;    /* sharp edge on black bg */
    casing-width: 1;
    z-index: 20;
}


*[shop=mall][verified!="true"][!name],
*[shop=mall][verified!="true"][name=""] {
    color: #00E5FF;          /* cyan, NOT selection red */
    width: 4;
    fill-color: #00E5FF;
    fill-opacity: 0.35;
    casing-color: white;    /* sharp edge on black bg */
    casing-width: 2;
    z-index: 10;
}

*[shop=mall][verified="true"] {
    color: #00FF0DFF;          /* green for verified (with alpha) */
    width: 2;
    casing-color: white;    /* sharp edge on black bg */
    casing-width: 1;
    z-index: 20;
}

